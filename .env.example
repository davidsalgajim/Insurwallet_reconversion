# Firebase Web SDK (client) — copy to .env.local and fill with your project values.
# Create projects at https://console.firebase.google.com/ (staging + prod).

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=insurwallet-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=insurwallet-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=insurwallet-staging.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional — Google Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Connect client SDK to local emulators (auth:9099, firestore:8080, storage:9199).
# Keep false for staging/production Firebase projects.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Staging: block app routes until email/password users verify their email.
# Dev/local: leave false to allow access with a dismissible in-app warning banner.
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false

# App Check (reCAPTCHA v3) — set for staging/production when emulators are off.
# Firebase Console → App Check → Register web app → reCAPTCHA v3 provider.
# Start Firestore/Storage in Monitor mode before Enforce.
# NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=6Lc...

# Local dev against real Firebase (not emulators): debug token from Console → App Check.
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=true
# For server-side Firestore REST (dev without Admin creds), copy the UUID from the browser
# console after first load, register it in App Check → Manage debug tokens, then set:
# FIREBASE_APPCHECK_DEBUG_TOKEN=your-registered-debug-uuid

# Firebase Admin SDK (server-only) — required for HttpOnly session cookies via /api/auth/session.
# Not needed when NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true (Admin connects to Auth + Firestore emulators without creds).
# Local dev without these vars still works for auth, consents, and notification prefs: verified ID tokens are stored
# as session cookies and user-scoped Firestore reads/writes use the REST API with that token (dev only).
# Other server routes (shares, payments checkout, document jobs) still need Admin credentials or emulators.
# Production / preview deploys MUST set one of the options below.
# Option A: inline service account JSON (escape newlines in private_key or use single-line JSON).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"insurwallet-stagging","private_key":"...","client_email":"..."}
# Option B: path to downloaded key file (local dev / CI). Add the JSON file to .gitignore.
# GOOGLE_APPLICATION_CREDENTIALS=./insurwallet-stagging-service-account.json

# Observability (optional — stubs no-op when unset)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# POSTHOG_KEY=

# Worker / internal job dispatch (server-only)
# Document pipeline worker (Cloud Run locally: http://localhost:8080)
WORKER_URL=http://localhost:8080
# Cloud Run prod: OIDC audience = worker service URL (no trailing slash)
# WORKER_OIDC_AUDIENCE=https://insurwallet-worker-xxxxx.run.app
# Comma-separated service account emails allowed to invoke the worker
# WORKER_ALLOWED_SERVICE_ACCOUNTS=nextjs@project.iam.gserviceaccount.com,firebase-adminsdk@project.iam.gserviceaccount.com
# APP_URL=https://your-next-app.example.com
# Required for local dev: same value in Next.js and worker process (min 16 chars).
# Without this, POST /api/jobs/.../process → worker returns 401/503 on localhost.
INTERNAL_API_SECRET=generate-a-long-random-secret-min-16-chars

# Claude extraction — worker only (never NEXT_PUBLIC_*). Required for document jobs.
# Also load into the worker shell when running uvicorn locally.
# ANTHROPIC_API_KEY=sk-ant-...

# GCS bucket for worker PDF downloads and RAG transcript storage
# (users/{uid}/policies/{id}/docs/{docId}/extracted/document.txt when >10KB).
# Defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
# Use the exact bucket from Firebase Console (*.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=insurwallet-staging.firebasestorage.app

# FCM Web Push (optional — browser push when configured)
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-public-key

# Payments — Mercado Pago (Colombia). Sandbox keys from MP Developers → Tus integraciones.
# MERCADOPAGO_ACCESS_TOKEN=TEST-...
# MERCADOPAGO_WEBHOOK_SECRET=your-webhook-signing-secret
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-...
# MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
#
# Legacy Wompi (deprecated — kept for reference only):
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_EVENTS_SECRET=events_test_...

# App metadata (client)
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_SUPPORT_EMAIL=support@insurwallet.com

# Transactional email (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=InsurWallet <notificaciones@tudominio.com>

# Feature flags (env fallback for Remote Config — default enabled unless "false")
# NEXT_PUBLIC_PAYMENTS_ENABLED=true
# PAYMENTS_ENABLED=true
# NEXT_PUBLIC_MARIANA_ENABLED=true
# MARIANA_ENABLED=true
# NEXT_PUBLIC_SURYA_FALLBACK=true

# App URL for emails, share links, checkout return (server-only preferred)
# APP_URL=https://your-next-app.example.com

# E2E Playwright (task 6.3) — smoke runs without emulators; full auth flow needs Auth emulator.
# E2E_FIREBASE_EMULATORS=true
# E2E_LOCALE=es
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Accessibility axe stub (task 6.5) — enable after vitest-axe is wired.
# A11Y_AXE_ENABLED=false

# MarIAna chat (server-only)
# ANTHROPIC_API_KEY=sk-ant-...

# MarIAna RAG embeddings — Google text-embedding-004 (768-dim, matches Firestore vector index)
# Requires cloud AI consent (users.consents.cloudAI = accepted). Falls back to keyword search without key.
# Chunk source: full document transcript (extractedSummary / extractedTextPath), not only structured fields.
# EMBEDDING_API_KEY=your-google-ai-api-key
# GOOGLE_AI_API_KEY=your-google-ai-api-key

# Sentry (optional — no-op without DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_ENVIRONMENT=development

# Transactional email — share invites (server-only)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=InsurWallet <noreply@yourdomain.com>
# APP_URL=https://your-next-app.example.com
