// InsurWallet Firestore access model:
// - users/{userId}: owner read/write only
// - policies/{policyId}: owner full CRUD; users in sharedWith[] get read-only
// - policies/{policyId}/documents and /auditLogs: inherit parent policy access
// - all other paths: denied
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isInSharedWith(sharedWith) {
      return sharedWith != null && request.auth.uid in sharedWith;
    }

    function canReadPolicy(policy) {
      return isOwner(policy.ownerUid) || isInSharedWith(policy.sharedWith);
    }

    function canWritePolicy(policy) {
      return isOwner(policy.ownerUid);
    }

    function parentPolicy() {
      return get(/databases/$(database)/documents/policies/$(policyId)).data;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /policies/{policyId} {
      allow read: if canReadPolicy(resource.data);
      allow create: if canWritePolicy(request.resource.data);
      allow update, delete: if canWritePolicy(resource.data);

      match /documents/{docId} {
        allow read: if canReadPolicy(parentPolicy());
        allow create, update, delete: if canWritePolicy(parentPolicy());
      }

      match /auditLogs/{logId} {
        allow read: if canReadPolicy(parentPolicy());
        allow create, update, delete: if canWritePolicy(parentPolicy());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
