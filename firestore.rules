// InsurWallet Firestore access model:
// - users/{userId}: owner read/write; subscription field is server-write only (Admin SDK / payment webhooks)
// - policies/{policyId}: owner full CRUD; users in sharedWith[] get read-only
// - policies/{policyId}/documents: inherit parent policy access
// - jobs/{jobId}: owner read-only (writes via Admin SDK / Cloud Functions)
// - all other paths: denied
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isInSharedWith(sharedWith) {
      return sharedWith != null && request.auth.uid in sharedWith;
    }

    function canReadPolicy(policy) {
      return policy != null
        && (isOwner(policy.ownerUid) || isInSharedWith(policy.sharedWith));
    }

    function canWritePolicy(policy) {
      return policy != null && isOwner(policy.ownerUid);
    }

    function parentPolicy(policyId) {
      return get(/databases/$(database)/documents/policies/$(policyId)).data;
    }

    function canReadParentPolicy(policyId) {
      return canReadPolicy(parentPolicy(policyId));
    }

    function canWriteParentPolicy(policyId) {
      return canWritePolicy(parentPolicy(policyId));
    }

    function isValidDocumentStoragePath(policyId, docId, storagePath) {
      let policy = parentPolicy(policyId);
      return storagePath.matches(
        'users/' + policy.ownerUid + '/policies/' + policyId + '/docs/' + docId + '/.+'
      );
    }

    function isAllowedDocumentMimeType(mimeType) {
      return mimeType == 'application/pdf'
        || mimeType == 'image/jpeg'
        || mimeType == 'image/png'
        || mimeType == 'image/webp';
    }

    function isValidDocumentData(policyId, docId, data) {
      return data.keys().hasAll(['storagePath', 'mimeType'])
        && isAllowedDocumentMimeType(data.mimeType)
        && isValidDocumentStoragePath(policyId, docId, data.storagePath);
    }

    // Clients cannot mutate subscription — only Cloud Functions (Admin SDK) after verified webhooks.
    function subscriptionUnchanged() {
      let hadSub = resource.data.keys().hasAny(['subscription']);
      let hasSub = request.resource.data.keys().hasAny(['subscription']);
      return hadSub == hasSub
        && (!hadSub || request.resource.data.subscription == resource.data.subscription);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && subscriptionUnchanged();
      allow delete: if isOwner(userId);

      match /contacts/{contactId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /beneficiaries/{beneficiaryId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Append-only audit trail for sensitive user actions (consent, export, delete).
      // Writes via Admin SDK / API routes only — clients cannot create or mutate logs.
      match /auditLogs/{logId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    function isShareOwner(share) {
      return share != null && isOwner(share.ownerUid);
    }

    function isShareRecipient(share) {
      return share != null
        && isSignedIn()
        && request.auth.token.email == share.recipientEmail;
    }

    function isValidShareCreate(data) {
      return data.keys().hasAll([
          'policyId',
          'ownerUid',
          'recipientEmail',
          'permission',
          'tokenHash',
          'expiresAt',
          'status',
          'createdAt',
        ])
        && data.ownerUid == request.auth.uid
        && data.status == 'pending'
        && data.permission in ['view', 'view_download'];
    }

    match /chats/{uid} {
      allow read, write: if isOwner(uid);

      match /messages/{messageId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    match /shares/{tokenHash} {
      allow read: if isShareOwner(resource.data) || isShareRecipient(resource.data);
      allow create: if isSignedIn() && isValidShareCreate(request.resource.data);
      allow update: if isShareOwner(resource.data)
        || (isShareRecipient(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'recipientUid'])
          && request.resource.data.status == 'accepted');
      allow delete: if isShareOwner(resource.data);
    }

    match /policies/{policyId} {
      allow read: if canReadPolicy(resource.data);
      allow create: if canWritePolicy(request.resource.data);
      allow update: if canWritePolicy(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canWritePolicy(resource.data);

      match /documents/{docId} {
        allow read: if canReadParentPolicy(policyId);
        allow create: if canWriteParentPolicy(policyId)
          && isValidDocumentData(policyId, docId, request.resource.data);
        allow update: if canWriteParentPolicy(policyId)
          && isValidDocumentData(policyId, docId, request.resource.data);
        allow delete: if canWriteParentPolicy(policyId);

        match /chunks/{chunkId} {
          allow read: if canReadParentPolicy(policyId);
          allow write: if false;
        }
      }

      match /beneficiaries/{beneficiaryId} {
        allow read: if canReadParentPolicy(policyId);
        allow create, update, delete: if canWriteParentPolicy(policyId);
      }

      match /auditLogs/{logId} {
        allow read: if canReadParentPolicy(policyId);
        allow create: if canWriteParentPolicy(policyId);
      }
    }

    match /jobs/{jobId} {
      allow read: if isOwner(resource.data.ownerUid);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
